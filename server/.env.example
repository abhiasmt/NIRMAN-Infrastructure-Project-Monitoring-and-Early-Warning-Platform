# --- Database -------------------------------------------------------------
DATABASE_URL="postgresql://nirman:nirman@localhost:5432/nirman?schema=public"

# --- API ------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Auth -----------------------------------------------------------------
# Replace with a long random string before any non-local use.
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=8h

# --- ML service -----------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000

# --- Scheduled jobs -------------------------------------------------------
# Nightly risk refresh (cron syntax). Set ENABLE_CRON=false to turn it off.
ENABLE_CRON=true
RISK_REFRESH_CRON=0 2 * * *
